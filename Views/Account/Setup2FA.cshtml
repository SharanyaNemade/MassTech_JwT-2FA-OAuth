@{
}




@model TwoFactorSetupModel

<h2>Setup Two Factor Authentication</h2>

<p>Scan this QR Code using Google Authenticator</p>

<img src="data:image/png;base64,@Model.QRCodeImage" />

<p>Manual Key:</p>
<b>@Model.ManualKey</b>

<form method="post" asp-action="Verify2FA">

    <input type="text" name="code" placeholder="Enter OTP Code" required />

    <button type="submit">Verify</button>

</form>